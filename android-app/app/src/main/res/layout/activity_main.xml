<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Volum laptop"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/hostLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="neconectat"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/volumeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/accent"
                    android:textSize="84sp"
                    android:letterSpacing="-0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="18dp"
                    android:layout_marginStart="4dp"
                    android:text="%"
                    android:textColor="@color/text_dim"
                    android:textSize="24sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/volumeBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bar_track" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/minusButton"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:background="@drawable/key_round"
                    android:text="−"
                    android:textColor="@color/text"
                    android:textSize="44sp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/plusButton"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginStart="28dp"
                    android:background="@drawable/key_round"
                    android:text="+"
                    android:textColor="@color/text"
                    android:textSize="44sp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="ține apăsat pentru schimbare rapidă"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/muteButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:background="@drawable/pill"
                    android:text="Mut"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/unmuteButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/pill"
                    android:text="Sunet pornit"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Conexiune"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/ipInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/input_bg"
            android:hint="192.168.100.180:5050"
            android:inputType="textUri"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_bg"
            android:hint="token"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="16sp" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill"
            android:text="Verifică conexiunea"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:text=""
            android:textColor="@color/text_dim"
            android:textIsSelectable="true"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
